# Required
BITBUCKET_URL=https://bitbucket.yourcompany.com

# Auth — choose one method:
# Option A: Personal Access Token (preferred)
BITBUCKET_TOKEN=your-token-here

# Option B: Basic auth
# BITBUCKET_USERNAME=your-username
# BITBUCKET_PASSWORD=your-password

# Optional behaviour
BITBUCKET_DEFAULT_PROJECT=MYPROJ
BITBUCKET_DIFF_MAX_LINES_PER_FILE=500
BITBUCKET_READ_ONLY=false
# BITBUCKET_LOG_PATH=/var/log/bitbucket-mcp/server.log

# Custom headers for Zero Trust / reverse proxy (Header=Value,OtherHeader=OtherValue)
# BITBUCKET_CUSTOM_HEADERS=X-Forwarded-For=10.0.0.1,X-Custom-Token=abc=def

# Transport (stdio is default; use http for remote access)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
